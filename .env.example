# Copy to .env (git-ignored). Never commit real values.
# Any provider left empty runs on the fake client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Response cache for real providers (repeat requests cost nothing). Empty: no cache. Delete the file to clear it.
LLM_CACHE=data/llm-cache.sqlite3
# Usage ledger: every LLM call and its cost. Always on; this is where it lives.
LEDGER_DB=data/ledger.sqlite3
# Credit wallet (4.2): where it lives, and the balance a new wallet opens with.
WALLET_DB=data/wallet.sqlite3
WALLET_START_CREDITS=100
# Guardrails (4.3) on real providers: input token budget per call, and a daily spending cap in USD (UTC days).
MAX_INPUT_TOKENS=8000
DAILY_SPEND_CAP_USD=1.00
